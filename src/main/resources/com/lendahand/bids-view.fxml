<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.lendahand.controllers.BidsViewController"
            style="-fx-background-color:#F7F6F2;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color:#FFFFFF;
                     -fx-padding:0 24 0 24; -fx-pref-height:62px;
                     -fx-border-color:#E8E8E8; -fx-border-width:0 0 2 0;
                     -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,3);">
            <Button text="&lt;- Dashboard" onAction="#handleBack"
                    style="-fx-background-color:#F7F6F2; -fx-text-fill:#64748B;
                           -fx-font-size:12px; -fx-background-radius:10;
                           -fx-border-color:#E2E8F0; -fx-border-radius:10;
                           -fx-border-width:1.5; -fx-padding:7 14; -fx-cursor:hand;"/>
            <Label text="🏷" style="-fx-font-size:22px;"/>
            <VBox spacing="1" alignment="CENTER_LEFT">
                <Label fx:id="titleLabel" text="Bids"
                       style="-fx-text-fill:#1E293B; -fx-font-size:18px; -fx-font-weight:bold;"/>
                <Label fx:id="subtitleLabel" text=""
                       style="-fx-text-fill:#94A3B8; -fx-font-size:11px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#handleRefresh"
                    style="-fx-background-color:#F7F6F2; -fx-text-fill:#64748B;
                           -fx-font-size:12px; -fx-background-radius:10;
                           -fx-border-color:#E2E8F0; -fx-border-radius:10;
                           -fx-border-width:1.5; -fx-padding:7 14; -fx-cursor:hand;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="0" style="-fx-background-color:#F7F6F2;">

            <!-- Feedback bar -->
            <Label fx:id="feedbackLabel" wrapText="true"
                   visible="false" maxWidth="800"
                   style="-fx-padding:10 24; -fx-font-size:13px;"/>

            <!-- Scrollable content -->
            <ScrollPane fx:id="scrollPane" fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color:transparent;
                               -fx-background:transparent;
                               -fx-border-color:transparent;">
                <VBox fx:id="contentBox" spacing="14"
                      style="-fx-padding:24; -fx-background-color:#F7F6F2;"/>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>