<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Cursor?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.lendahand.controllers.RegisterController"
            prefWidth="980" prefHeight="720"
            style="-fx-background-color:#F7F6F2;">

    <center>
        <HBox style="-fx-background-color:#F7F6F2;">

            <VBox alignment="CENTER" spacing="0" prefWidth="440"
                  style="-fx-background-color:#4ECDC4; -fx-padding:50;">

                <HBox spacing="10" alignment="CENTER"
                      style="-fx-padding:0 0 16 0;">
                    <Label text="◆" style="-fx-text-fill:rgba(255,255,255,0.5); -fx-font-size:24px;"/>
                    <Label text="✦" style="-fx-text-fill:rgba(255,255,255,0.7); -fx-font-size:16px;"/>
                    <Label text="●" style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:28px;"/>
                    <Label text="✦" style="-fx-text-fill:rgba(255,255,255,0.6); -fx-font-size:20px;"/>
                </HBox>

                <Label text="🤝" style="-fx-font-size:58px; -fx-padding:0 0 10 0;"/>
                <Label text="LendAHand"
                       style="-fx-text-fill:#FFFFFF; -fx-font-size:38px;
                              -fx-font-weight:bold; -fx-padding:0 0 6 0;"/>
                <Label text="Connect with your community. Earn money doing tasks you enjoy."
                       style="-fx-text-fill:rgba(255,255,255,0.75);-fx-font-size:13px;"
                       wrapText="true" textAlignment="CENTER" maxWidth="300"/>

                <VBox spacing="12" maxWidth="300" style="-fx-padding:16 0 0 0;">
                    <VBox spacing="6" alignment="CENTER"
                          style="-fx-background-color:rgba(255,255,255,0.2); -fx-background-radius:14; -fx-padding:16;">
                        <Label text="🧑‍💼  Task Poster" style="-fx-text-fill:#FFFFFF;-fx-font-weight:bold;-fx-font-size:14px;"/>
                        <Label text="Post tasks, set your budget, get things done fast." style="-fx-text-fill:rgba(255,255,255,0.7);-fx-font-size:11px;" wrapText="true" textAlignment="CENTER" maxWidth="240"/>
                        <Label text="Starts with Rs. 200 wallet bonus! 🎁" style="-fx-text-fill:#FFD166;-fx-font-size:11px;-fx-font-weight:bold;"/>
                    </VBox>
                    <VBox spacing="6" alignment="CENTER"
                          style="-fx-background-color:rgba(255,255,255,0.2); -fx-background-radius:14; -fx-padding:16;">
                        <Label text="🦺  Helper" style="-fx-text-fill:#FFFFFF;-fx-font-weight:bold;-fx-font-size:14px;"/>
                        <Label text="Browse tasks nearby, bid your price, earn Rupees." style="-fx-text-fill:rgba(255,255,255,0.7);-fx-font-size:11px;" wrapText="true" textAlignment="CENTER" maxWidth="240"/>
                        <Label text="Flexible. Work on your own schedule. 💪" style="-fx-text-fill:#FFD166;-fx-font-size:11px;-fx-font-weight:bold;"/>
                    </VBox>
                </VBox>

                <HBox spacing="10" alignment="CENTER" style="-fx-padding:20 0 0 0;">
                    <Label text="✶" style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:22px;"/>
                    <Label text="✦" style="-fx-text-fill:rgba(255,255,255,0.6); -fx-font-size:16px;"/>
                    <Label text="◆" style="-fx-text-fill:rgba(255,255,255,0.5); -fx-font-size:20px;"/>
                </HBox>
            </VBox>

            <VBox alignment="CENTER" spacing="0" HBox.hgrow="ALWAYS"
                  style="-fx-background-color:#FFFFFF; -fx-padding:40 60 40 60;">

                <Label text="Create your account ✨"
                       style="-fx-text-fill:#1E293B; -fx-font-size:26px; -fx-font-weight:bold; -fx-padding:0 0 4 0;"/>
                <Label text="It's free and takes 30 seconds"
                       style="-fx-text-fill:#94A3B8; -fx-font-size:13px; -fx-padding:0 0 24 0;"/>

                <VBox spacing="12" maxWidth="370" fillWidth="true">

                    <VBox spacing="5">
                        <Label text="FULL NAME" style="-fx-text-fill:#64748B; -fx-font-size:12px; -fx-font-weight:bold;"/>
                        <TextField fx:id="nameField" promptText="Ali Hassan" style="-fx-background-color:#F8FAFC; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-background-radius:8; -fx-padding:12;" maxWidth="370"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="EMAIL ADDRESS" style="-fx-text-fill:#64748B; -fx-font-size:12px; -fx-font-weight:bold;"/>
                        <TextField fx:id="emailField" promptText="ali@example.com" style="-fx-background-color:#F8FAFC; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-background-radius:8; -fx-padding:12;" maxWidth="370"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="PASSWORD" style="-fx-text-fill:#64748B; -fx-font-size:12px; -fx-font-weight:bold;"/>
                        <PasswordField fx:id="passwordField" promptText="Min 6 characters" style="-fx-background-color:#F8FAFC; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-background-radius:8; -fx-padding:12;" maxWidth="370"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="CONFIRM PASSWORD" style="-fx-text-fill:#64748B; -fx-font-size:12px; -fx-font-weight:bold;"/>
                        <PasswordField fx:id="confirmField" promptText="Repeat your password" style="-fx-background-color:#F8FAFC; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-background-radius:8; -fx-padding:12;" maxWidth="370" onAction="#handleRegister"/>
                    </VBox>

                    <VBox spacing="8" style="-fx-padding:4 0 0 0;">
                        <Label text="I WANT TO..." style="-fx-text-fill:#64748B; -fx-font-size:12px; -fx-font-weight:bold;"/>
                        <HBox spacing="10">
                            <RadioButton fx:id="posterRadio" text="Post Tasks 🧑‍💼"
                                         style="-fx-background-color:#FFF0F0; -fx-background-radius:10; -fx-padding:8 16 8 16; -fx-border-color:#FFD6D6; -fx-border-radius:10; -fx-border-width:1.5;">
                                <cursor><Cursor fx:constant="HAND"/></cursor>
                            </RadioButton>
                            <RadioButton fx:id="helperRadio" text="Help and Earn 🦺"
                                         style="-fx-background-color:#F0FFFD; -fx-background-radius:10; -fx-padding:8 16 8 16; -fx-border-color:#C7F5F1; -fx-border-radius:10; -fx-border-width:1.5;">
                                <cursor><Cursor fx:constant="HAND"/></cursor>
                            </RadioButton>
                        </HBox>
                    </VBox>
                </VBox>

                <Label fx:id="errorLabel" visible="false" wrapText="true" maxWidth="370"
                       style="-fx-text-fill:#EF4444; -fx-font-size:13px; -fx-padding:12 0 0 0;"/>

                <Region prefHeight="16" />

                <Button text="Create Account →" onAction="#handleRegister"
                        maxWidth="370" prefHeight="50"
                        style="-fx-background-color:#FF6B6B; -fx-text-fill:white; -fx-font-size:15px; -fx-font-weight:bold; -fx-background-radius:8;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>

                <HBox alignment="CENTER" spacing="6" style="-fx-padding:16 0 0 0;">
                    <Label text="Already have an account?" style="-fx-text-fill:#64748B; -fx-font-size:13px;"/>
                    <Button text="Sign in →" onAction="#handleGoToLogin"
                            style="-fx-background-color:transparent; -fx-text-fill:#FF6B6B; -fx-font-weight:bold; -fx-font-size:13px; -fx-padding:0;">
                        <cursor><Cursor fx:constant="HAND"/></cursor>
                    </Button>
                </HBox>

            </VBox>
        </HBox>
    </center>
</BorderPane>